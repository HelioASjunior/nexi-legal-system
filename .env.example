# ── BACKEND (nunca commitar com valores reais) ────────────────────────────────

# Porta da API
PORT=4000

# Chave de criptografia do banco SQLite (AES-256).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Armazene em segredo — NUNCA commitar o valor real.
SQLITE_DATA_KEY=replace-with-strong-64-hex-chars

# Origens permitidas pelo CORS (separadas por vírgula).
# Em produção, use apenas o domínio real (ex: https://seudominio.com.br).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Seed de admin: cria o primeiro administrador se o banco estiver vazio.
# Remova após o primeiro login e troque a senha pelo painel.
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=

# ── FRONTEND (apenas variáveis não-sensíveis com prefixo VITE_) ───────────────
# ATENÇÃO: qualquer VITE_* fica embutido no bundle JavaScript público.
# Nunca adicione senhas, API keys ou chaves criptográficas com prefixo VITE_.

VITE_API_BASE_URL=http://localhost:4000
VITE_REQUIRE_DATABASE=true

# API pública de CEP (sem credencial)
VITE_VIA_CEP_API_BASE_URL=https://viacep.com.br/ws

# ── SCRIPTS (opcional, apenas desenvolvimento local) ──────────────────────────
SCREENSHOT_LOGIN=
SCREENSHOT_PASSWORD=
